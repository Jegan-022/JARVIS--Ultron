# ULTRON backend — copy to .env and fill in values.
# Never commit .env. Keys stay on the server; the frontend never receives them.

# Server
ULTRON_HOST=127.0.0.1
ULTRON_PORT=8000
ULTRON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (provider-independent; unused in Phase 1)
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.1
LLM_PROVIDER=ollama

# Speech
STT_PROVIDER=browser
TTS_PROVIDER=browser
WAKE_WORD=ultron

# Home Assistant (Phase 7+)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# MQTT / ESP32 (Phase 8+)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ultron
